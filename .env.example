# ---------------------------------------------------------------------------
# StudioSpace server - copy this file to `.env` and fill in real values.
# `.env` is gitignored. NEVER commit real secrets.
# ---------------------------------------------------------------------------

# Runtime
NODE_ENV=development
PORT=5000

# MongoDB
MONGODB_URI=mongodb://localhost:27017
DB_NAME=studiospace

# Allowed browser client origin (CORS and CSRF), with no trailing slash
CLIENT_URL=http://localhost:3000

# Better Auth - generate a strong random value (at least 32 characters)
BETTER_AUTH_SECRET=replace-with-a-long-random-secret
# Public URL of this API, with no path
BETTER_AUTH_URL=http://localhost:5000

# Optional: Google sign-in. Create an OAuth client at
# https://console.cloud.google.com/apis/credentials with the authorized redirect
# URI <BETTER_AUTH_URL>/api/auth/callback/google. Leave blank to turn it off.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional logging threshold: debug | info | warn | error
LOG_LEVEL=info
