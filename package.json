{
  "name": "studiospace-server",
  "version": "1.0.0",
  "description": "Backend API for StudioSpace - a peer-to-peer creative workspace and production studio sharing platform.",
  "private": true,
  "main": "dist/server.js",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "type-check": "tsc --noEmit",
    "test": "node --import tsx --test --test-concurrency=1 src/tests/*.test.ts",
    "seed": "tsx src/scripts/seed.ts"
  },
  "dependencies": {
    "better-auth": "^1.7.15",
    "cors": "^2.8.6",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "mongodb": "^7.8.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "mongodb-memory-server": "^11.3.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
